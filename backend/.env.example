DATABASE_URL=sqlite:///./everreach.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:8b-llama3.1-q4_K_M
OLLAMA_TIMEOUT_SECONDS=180

LOG_LEVEL=INFO

CORS_ORIGINS=["http://localhost:5173"]

# Phase 23D — local ComfyUI integration (see app.game.visual.comfyui_client).
# Disabled by default so a fresh checkout / CI never tries to reach a
# local GPU server. Local ComfyUI install lives at E:\RPG\ComfyUI,
# raw generation output at E:\RPG\ComfyData\output.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false
COMFYUI_RAW_OUTPUT_ROOT=E:\RPG\ComfyData\output
# Reserved for a later subphase (23D-F, persistent Everreach-accepted assets).
COMFYUI_ASSET_ROOT=E:\RPG\EverreachAssets
