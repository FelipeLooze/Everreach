DATABASE_URL=sqlite:///./everreach.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:8b-llama3.1-q4_K_M
OLLAMA_TIMEOUT_SECONDS=180

LOG_LEVEL=INFO

CORS_ORIGINS=["http://localhost:5173"]

# Phase 23D — local ComfyUI integration (see app.game.visual.comfyui_client).
# Disabled by default so a fresh checkout / CI never tries to reach a
# local GPU server. Local ComfyUI install lives at E:\RPG\ComfyUI,
# raw generation output at E:\RPG\ComfyData\output.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=false
COMFYUI_RAW_OUTPUT_ROOT=E:\RPG\ComfyData\output
COMFYUI_WORKFLOW_ROOT=E:\RPG\Workflows\api
COMFYUI_ASSET_ROOT=E:\RPG\EverreachAssets
# Phase 23D-R.1 — ComfyUI's own input directory. A canonical NPC
# reference image must be staged (copied) here before a reference-based
# generation can use it; ComfyUI's LoadImage node cannot resolve a path
# outside its own input directory.
COMFYUI_INPUT_ROOT=E:\RPG\ComfyData\input

# Phase 24K — OpenRouter (https://openrouter.ai), a second LLM provider
# alongside Ollama. Never commit a real value here — this key must come
# from your own local .env (gitignored) or the real environment only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_TEMPERATURE=0.35
OPENROUTER_MAX_TOKENS=2000
# Optional OpenRouter attribution headers — not required.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Groq is recommended for the fast intent-classification role. Create a
# key at https://console.groq.com/keys and never commit the real value.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=500

# Phase 24K — intent parsing and narrative generation can each use a
# different provider ("ollama", "openrouter" or "groq") and model. Leaving both
# on ollama with an empty *_LLM_MODEL (the default) behaves exactly as
# before this phase. To evaluate a stronger remote model for narration
# only (recommended first configuration — keeps free OpenRouter calls
# for narration, not trivial intent classification):
#   NARRATIVE_LLM_PROVIDER=openrouter
#   NARRATIVE_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Use the exact OpenRouter model ID — never the "openrouter/free" router
# alias, which can silently pick a different free model per call.
INTENT_LLM_PROVIDER=ollama
INTENT_LLM_MODEL=
NARRATIVE_LLM_PROVIDER=ollama
NARRATIVE_LLM_MODEL=
NARRATIVE_AUTOMATIC_VALIDATION_ENABLED=false
# Keep the instruction in the prompt but let the player review agency
# mistakes manually with "Regenerate last message" when set to false.
NARRATIVE_PLAYER_AGENCY_GUARD_ENABLED=true
# Set the automatic roles above to "disabled" to make no automatic LLM calls.
# Regeneration is a separate, explicitly user-triggered role.
REGENERATION_LLM_PROVIDER=disabled
REGENERATION_LLM_MODEL=
